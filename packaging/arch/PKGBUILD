# Maintainer: Werner <wernerj101@gmail.com>
pkgname=backuper-git
_name=backuper
pkgver=0.1.0
pkgrel=1
pkgdesc="Manifest-driven rsync backups with a systemd user timer and journal logging"
arch=(any)
url="https://github.com/werner-smit/backuper"
license=(MIT)
depends=(python python-click python-tomli-w rsync)
makedepends=(git python-build python-installer python-hatchling)
provides=("$_name")
conflicts=("$_name")

# Builds GitHub main by default. LOCAL=1 builds the committed HEAD of the
# checkout this PKGBUILD lives in instead:  LOCAL=1 makepkg -si
# (separate clone dirs, since makepkg won't reuse a clone whose URL changed)
if [[ -n $LOCAL ]]; then
  _srcdir="$_name-local"
  source=("$_srcdir::git+file://${startdir%/packaging/arch}")
else
  _srcdir="$_name"
  source=("$_srcdir::git+$url.git#branch=main")
fi
sha256sums=(SKIP)

pkgver() {
  cd "$_srcdir"
  local base
  base=$(python -c 'import tomllib; print(tomllib.load(open("pyproject.toml","rb"))["project"]["version"])')
  printf "%s.r%s.g%s" "$base" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_srcdir"
  python -m build --wheel --no-isolation
  for shell in bash zsh fish; do
    PYTHONPATH=src _BACKUPER_COMPLETE=${shell}_source python -m backuper > "completion.$shell"
  done
}

package() {
  cd "$_srcdir"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 systemd/backuper.service "$pkgdir/usr/lib/systemd/user/backuper.service"
  install -Dm644 systemd/backuper.timer "$pkgdir/usr/lib/systemd/user/backuper.timer"
  install -Dm644 completion.bash "$pkgdir/usr/share/bash-completion/completions/backuper"
  install -Dm644 completion.zsh "$pkgdir/usr/share/zsh/site-functions/_backuper"
  install -Dm644 completion.fish "$pkgdir/usr/share/fish/vendor_completions.d/backuper.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
